    def cmd_sellall(self, update, context):

        """

        실제 API로 모든 position 조회 후 best_ask 가격에 매도

        - get_my_positions() API 사용

        - YES/NO token 모두 확인

        - 각 position을 best_ask 가격에 매도 리미트 오더

        - 메이커 온리 (최상단 호가 유지)

        """

        if not self._auth(update): return

        if not self.mgr.client:

            update.message.reply_text("❌ Client not ready")

            return

        

        update.message.reply_text("🔍 Checking positions via API...")

        

        # 1) 실제 API로 모든 position 조회

        try:

            positions_data = self.mgr.client.get_my_positions(limit=100)

        except Exception as e:

            update.message.reply_text(f"❌ API error: {str(e)[:100]}")

            return

        

        if not positions_data:

            update.message.reply_text("✅ No positions found")

            return

        

        # 2) Position 데이터 파싱

        sell_targets = []

        for pos in positions_data:

            try:

                # Position 데이터 구조 파싱

                token_id = str(pos.get("token_id") or pos.get("tokenId") or "")

                amount_str = str(pos.get("amount") or pos.get("balance") or "0")

                

                if not token_id:

                    continue

                

                # Amount를 Decimal로 변환 (18 decimals)

                try:

                    amount = Decimal(amount_str) / Decimal(10**18)

                except:

                    continue

                

                if amount < CONFIG["MIN_ORDER_SIZE"]:

                    continue

                

                # Market 정보 조회

                market_id = pos.get("market_id") or pos.get("marketId")

                

                # Token ID로 market 찾기 (세션에서)

                found_session = None

                found_side = None

                

                for mid, s in self.mgr.sessions.items():

                    if s.market.yes_token_id == token_id:

                        found_session = s

                        found_side = "YES"

                        break

                    elif s.market.no_token_id == token_id:

                        found_session = s

                        found_side = "NO"

                        break

                

                # 세션에 없으면 market_id로 market 조회

                if not found_session and market_id:

                    try:

                        market = self.mgr.client.get_market(int(market_id))

                        if market:

                            # 임시 세션 생성 (매도용)

                            if market.yes_token_id == token_id:

                                found_side = "YES"

                            elif market.no_token_id == token_id:

                                found_side = "NO"

                            

                            if found_side:

                                sell_targets.append({

                                    "market_id": int(market_id),

                                    "market": market,

                                    "side": found_side,

                                    "token_id": token_id,

                                    "amount": amount,

                                    "session": None

                                })

                    except:

                        pass

                

                elif found_session and found_side:

                    sell_targets.append({

                        "market_id": found_session.market.market_id,

                        "market": found_session.market,

                        "side": found_side,

                        "token_id": token_id,

                        "amount": amount,

                        "session": found_session

                    })

                    

            except Exception as e:

                continue

        

        if not sell_targets:

            update.message.reply_text("✅ No valid positions to sell")

            return

        

        # 3) 매도 주문 실행

        msg = f"🔄 Selling {len(sell_targets)} positions:\n"

        success = 0

        failed = 0

        

        for target in sell_targets:

            market_id = target["market_id"]

            side = target["side"]

            token_id = target["token_id"]

            amount = target["amount"]

            market = target["market"]

            session = target["session"]

            

            try:

                # 세션이 있으면 기존 매도 주문 취소

                if session:

                    sell_order = session.yes_sell_order if side == "YES" else session.no_sell_order

                    if sell_order and sell_order.status == "open":

                        self.mgr.cancel_sell(session, side, sell_order)

                

                # Best prices 조회

                best_bid, best_ask = self.mgr.client.get_best_prices(token_id)

                

                if not best_ask:

                    msg += f"\n⚠️ m#{market_id} {side}: No best_ask"

                    failed += 1

                    continue

                

                # 매도 가격 계산 (best_ask)

                my_price = q_price(best_ask)

                my_price = max(Decimal("0.01"), min(my_price, Decimal("0.99")))

                

                # 세션이 있으면 매도 보호 체크

                if session and self.mgr._check_sell_protection(session, side, best_ask):

                    msg += f"\n🛡️ m#{market_id} {side}: Sell protection (price too low)"

                    failed += 1

                    continue

                

                # Maker-only guard 체크

                if CONFIG["MAKER_ONLY_GUARD"] and best_bid is not None and best_bid >= best_ask:

                    msg += f"\n🧷 m#{market_id} {side}: Guard block (crossed spread)"

                    failed += 1

                    continue

                

                # 매도 주문 실행

                if session:

                    # 세션이 있으면 place_sell 사용

                    self.mgr.place_sell(session, side, token_id, amount, my_price, best_ask)

                else:

                    # 세션 없으면 직접 주문

                    try:

                        order_resp = self.mgr.client.place_order(

                            token_id=token_id,

                            side="SELL",

                            amount=int(amount * Decimal(10**18)),  # Convert to wei

                            price=float(my_price) / 100,  # Convert cents to decimal

                            order_type="LIMIT"

                        )

                        if order_resp:

                            msg += f"\n📤 m#{market_id} {side}: {amount:.2f} @ {my_price}¢"

                            success += 1

                        else:

                            msg += f"\n❌ m#{market_id} {side}: Order failed"

                            failed += 1

                    except Exception as e:

                        msg += f"\n❌ m#{market_id} {side}: {str(e)[:40]}"

                        failed += 1

                    continue

                

                msg += f"\n📤 m#{market_id} {side}: {amount:.2f} @ {my_price}¢"

                success += 1

                

            except Exception as e:

                msg += f"\n❌ m#{market_id} {side}: {str(e)[:40]}"

                failed += 1

        

        msg += f"\n\n✅ Success: {success} | ❌ Failed: {failed}"

        update.message.reply_text(msg)



    def cmd_status(self, update, context):

        if not self._auth(update): return

        if context.args:

            mid = int(context.args[0])

            s = self.mgr.session_status(mid)

            if not s:

                update.message.reply_text("❌ No session")

                return

            

            yes_status = "⏸️" if s['yes_paused'] else "▶️"

            no_status = "⏸️" if s['no_paused'] else "▶️"

            

            update.message.reply_text(

                f"📈 Status m#{s['market_id']} ({s['state']})\n\n"

                f"{yes_status} YES: budget ${s['yes_budget']:.4f} | pos {s['yes_position']:.6f} | avg_buy {s['yes_avg_buy']:.4f}\n"

                f"{no_status} NO:  budget ${s['no_budget']:.4f} | pos {s['no_position']:.6f} | avg_buy {s['no_avg_buy']:.4f}\n\n"

                f"Orders:\n"

                f"  YES B {s['yes_buy']} / S {s['yes_sell']}\n"

                f"  NO  B {s['no_buy']} / S {s['no_sell']}\n\n"

                f"Vol ${s['volume']:.4f} | Fills {s['trades']} | Fees ${s['fees']:.4f} | PnL ${s['pnl']:.4f}\n"

                f"🛡️ Protection triggers: {s['protections']}"

            )

        else:

            sm = self.mgr.summary()

            update.message.reply_text(

                f"📊 Summary\n"

                f"Sessions: {sm['sessions']} | Markets: {sm['market_ids']}\n"

                f"Volume: ${sm['volume']:,.4f} | Fills: {sm['trades']}\n"

                f"Fees:   ${sm['fees']:,.4f}\n"

                f"PnL:    ${sm['pnl']:,.4f}\n"

                f"🛡️ Protection triggers: {sm['protections']}"

            )



    def _metric_cmd(self, update, context, which: str):

        if not self._auth(update): return

        if context.args:

            mid = int(context.args[0])

            s = self.mgr.session_status(mid)

            if not s:

                update.message.reply_text("❌ No session")

                return

            mapping = {

                "volume": f"${s['volume']:,.4f} | fills {s['trades']}",

                "fee":    f"${s['fees']:,.4f}",

                "pnl":    f"${s['pnl']:,.4f}",

                "stats":  f"Vol ${s['volume']:,.4f} | Fills {s['trades']} | Fees ${s['fees']:,.4f} | PnL ${s['pnl']:,.4f}",

            }

            update.message.reply_text(f"{which.upper()} m#{mid}: {mapping[which]}")

        else:

            sm = self.mgr.summary()

            mapping = {

                "volume": f"${sm['volume']:,.4f} | fills {sm['trades']}",

                "fee":    f"${sm['fees']:,.4f}",

                "pnl":    f"${sm['pnl']:,.4f}",

                "stats":  f"Vol ${sm['volume']:,.4f} | Fills {sm['trades']} | Fees ${sm['fees']:,.4f} | PnL ${sm['pnl']:,.4f}",

            }

            update.message.reply_text(f"{which.upper()} ALL: {mapping[which]}")



    def cmd_volume(self, update, context): self._metric_cmd(update, context, "volume")

    def cmd_fee(self, update, context): self._metric_cmd(update, context, "fee")

    def cmd_pnl(self, update, context): self._metric_cmd(update, context, "pnl")

    def cmd_stats(self, update, context): self._metric_cmd(update, context, "stats")



    def start(self):

        if not TELEGRAM_AVAILABLE or not CONFIG["TELEGRAM_BOT_TOKEN"]:

            print("❌ Telegram not configured")

            return



        tg_logger.setup(CONFIG["TELEGRAM_BOT_TOKEN"], str(CONFIG["TELEGRAM_CHAT_ID"]))



        self.updater = Updater(token=CONFIG["TELEGRAM_BOT_TOKEN"], use_context=True)

        dp = self.updater.dispatcher



        dp.add_handler(CommandHandler("start", self.cmd_start))

        dp.add_handler(CommandHandler("help", self.cmd_help))

        dp.add_handler(CommandHandler("markets", self.cmd_markets))

        dp.add_handler(CommandHandler("market", self.cmd_market))

        dp.add_handler(CommandHandler("raw", self.cmd_raw))

        dp.add_handler(CommandHandler("marketsraw", self.cmd_marketsraw))

        dp.add_handler(CommandHandler("topicraw", self.cmd_topicraw))



        dp.add_handler(CommandHandler("run", self.cmd_run))

        dp.add_handler(CommandHandler("stop", self.cmd_stop))

        dp.add_handler(CommandHandler("pause", self.cmd_pause))

        dp.add_handler(CommandHandler("resume", self.cmd_resume))

        dp.add_handler(CommandHandler("unpause", self.cmd_unpause))



        dp.add_handler(CommandHandler("status", self.cmd_status))

        dp.add_handler(CommandHandler("volume", self.cmd_volume))

        dp.add_handler(CommandHandler("fee", self.cmd_fee))

        dp.add_handler(CommandHandler("pnl", self.cmd_pnl))

        dp.add_handler(CommandHandler("stats", self.cmd_stats))



        dp.add_handler(CommandHandler("kill", self.cmd_kill))

        dp.add_handler(CommandHandler("sellall", self.cmd_sellall))

        dp.add_handler(CallbackQueryHandler(self.callback_page, pattern=r"^p_"))



        print("🤖 Telegram bot starting (non-blocking mode)...")

        

        # ✅ Non-blocking 방식: start_polling()만 호출

        # idle()를 호출하지 않아 Jupyter 커널이 블로킹되지 않음

        self.updater.start_polling()

        

        print("✅ Telegram bot started! (Jupyter-friendly mode)")

        print("💡 Bot is running in background. Use other cells freely!")

        print("⚠️ To stop: Run 'tg.stop()' in a new cell")



    def stop(self):

        tg_logger.stop()

        if self.updater:

            self.updater.stop()



