# main

# ============================================================

mgr: Optional[StrategyManager] = None

tg: Optional[TelegramController] = None



def run_bot():

    """

    Jupyter-friendly non-blocking 봇 실행

    - 메인 스레드를 블로킹하지 않음

    - 다른 셀 실행 가능

    """

    global mgr, tg



    if not ENV_OK:

        print("❌ 환경변수 설정 필요")

        return



    print("🚀 Opinion Volume Bot v4.3.7 (Jupyter-Optimized)")



    mgr = StrategyManager()

    if not mgr.initialize():

        print("❌ Init failed")

        return



    mgr.restore_state()

    mgr.start_loop()  # Background thread



    tg = TelegramController(mgr)

    tg.start()  # Non-blocking

    

    print("\n" + "="*50)

    print("✅ Bot is running in background!")

    print("="*50)

    print("💡 You can now use other Jupyter cells freely")

    print("⚠️ To stop bot: run `stop_bot()` in a new cell")

    print("="*50 + "\n")

    

    return mgr, tg



def stop_bot():

    """봇 안전하게 종료"""

    global mgr, tg

    

    print("🛑 Stopping bot...")

    

    if mgr:

        try:

            mgr.stop_loop()

            mgr.save_state(force=True)

            print("✅ Manager stopped")

        except Exception as e:

            print(f"⚠️ Manager stop error: {e}")

    

    if tg:

        try:

            tg.stop()

            print("✅ Telegram stopped")

        except Exception as e:

            print(f"⚠️ Telegram stop error: {e}")

    

    print("✅ Bot stopped successfully!")



if __name__ == "__main__":

    # Script 실행 시

    run_bot()

    

    # Keep alive (script mode only)

    try:

        import time

        while True:

            time.sleep(1)

    except KeyboardInterrupt:

        stop_bot()
