class StrategyManager:

    def __init__(self):

        self.client: Optional[OpinionClient] = None

        self._lock = threading.RLock()

        self._loop_thread: Optional[threading.Thread] = None

        self._stop_flag = False

        self._last_save_ts = 0.0



        self.sessions: Dict[int, SessionState] = {}

        self._seen_sets: Dict[int, set] = {}

        self._seen_deques: Dict[int, deque] = {}



        self._last_guard_log: Dict[str, float] = {}



    def initialize(self) -> bool:

        try:

            self.client = OpinionClient()

            return True

        except Exception as e:

            print(f"❌ Init failed: {e}")

            return False



    # persistence

    def save_state(self, force: bool = False):

        now = time.time()

        if not force and (now - self._last_save_ts) < CONFIG["STATE_SAVE_MIN_INTERVAL_SEC"]:

            return

        with self._lock:

            data = {

                "version": "4.2",

                "saved_at": now,

                "sessions": [asdict(s) for s in self.sessions.values()],

            }

        try:

            atomic_write_json(CONFIG["STATE_FILE"], data)

            self._last_save_ts = now

        except Exception as e:

            # avoid log spam on persistent FS/permission errors

            key = "state_save_failed"

            last = self._last_guard_log.get(key, 0.0)

            if (now - last) > 30:  # 30초에 한 번만 로그

                tg_log(f"⚠️ state save failed: {e}")

                self._last_guard_log[key] = now



    def restore_state(self):

        path = CONFIG["STATE_FILE"]

        if not os.path.exists(path):

            return

        try:

            with open(path, "r", encoding="utf-8") as f:

                data = json.load(f)

        except Exception as e:

            tg_log(f"⚠️ state load failed: {e}")

            return



        sess_list = data.get("sessions") or []

        restored = 0

        with self._lock:

            self.sessions.clear()

            self._seen_sets.clear()

            self._seen_deques.clear()



            for sd in sess_list:

                try:

                    m = sd["market"]

                    market = MarketInfo(

                        market_id=int(m["market_id"]),

                        title=str(m["title"]),

                        yes_token_id=str(m["yes_token_id"]),

                        no_token_id=str(m["no_token_id"]),

                        status=int(m["status"]),

                    )

                    

                    stats_data = sd.get("stats") or {}

                    stats = Stats(

                        total_volume=str(stats_data.get("total_volume", "0")),

                        total_trades=int(stats_data.get("total_trades", 0)),

                        buy_cost=str(stats_data.get("buy_cost", "0")),

                        sell_proceeds=str(stats_data.get("sell_proceeds", "0")),

                        total_fees=str(stats_data.get("total_fees", "0")),

                        realized_pnl=str(stats_data.get("realized_pnl", "0")),

                    )

                    

                    s = SessionState(

                        market=market,

                        total_budget=str(sd.get("total_budget", "0")),

                        yes_budget=str(sd.get("yes_budget", "0")),

                        no_budget=str(sd.get("no_budget", "0")),

                        yes_position=str(sd.get("yes_position", "0")),

                        no_position=str(sd.get("no_position", "0")),

                        yes_buy_order=OrderInfo(**sd["yes_buy_order"]) if sd.get("yes_buy_order") else None,

                        no_buy_order=OrderInfo(**sd["no_buy_order"]) if sd.get("no_buy_order") else None,

                        yes_sell_order=OrderInfo(**sd["yes_sell_order"]) if sd.get("yes_sell_order") else None,

                        no_sell_order=OrderInfo(**sd["no_sell_order"]) if sd.get("no_sell_order") else None,

                        stats=stats,

                        state=str(sd.get("state", BotState.RUNNING.value)),

                        seen_trade_uids=sd.get("seen_trade_uids") or [],

                        # 손실 보호 필드 복원

                        yes_avg_buy_price=str(sd.get("yes_avg_buy_price", "0")),

                        no_avg_buy_price=str(sd.get("no_avg_buy_price", "0")),

                        yes_total_buy_cost=str(sd.get("yes_total_buy_cost", "0")),

                        no_total_buy_cost=str(sd.get("no_total_buy_cost", "0")),

                        yes_side_paused=bool(sd.get("yes_side_paused", False)),

                        no_side_paused=bool(sd.get("no_side_paused", False)),

                        yes_last_best_ask=str(sd.get("yes_last_best_ask", "0")),

                        no_last_best_ask=str(sd.get("no_last_best_ask", "0")),

                        protection_triggered_count=int(sd.get("protection_triggered_count", 0)),

                    )

                    self.sessions[market.market_id] = s



                    dq = deque(s.seen_trade_uids[-CONFIG["TRADE_DEDUPE_MAX"]:], maxlen=CONFIG["TRADE_DEDUPE_MAX"])

                    st = set(dq)

                    self._seen_deques[market.market_id] = dq

                    self._seen_sets[market.market_id] = st



                    restored += 1

                except Exception as e:

                    tg_log(f"⚠️ restore session failed: {e}")

                    continue



        if restored:

            tg_log(f"♻️ Restored {restored} session(s) from state")

            self.reconcile_all_sessions()

            self.save_state(force=True)



    def reconcile_all_sessions(self):

        with self._lock:

            mids = list(self.sessions.keys())

        for mid in mids:

            try:

                self.sync_trades(mid)

                self.reconcile_orders(mid)

            except Exception as e:

                tg_log(f"⚠️ reconcile failed (market {mid}): {e}")



    # loop

    def start_loop(self):

        if self._loop_thread and self._loop_thread.is_alive():

            return

        self._stop_flag = False

        self._loop_thread = threading.Thread(target=self._main_loop, daemon=True)

        self._loop_thread.start()



    def stop_loop(self):

        self._stop_flag = True

        if self._loop_thread:

            self._loop_thread.join(timeout=10)



    def _main_loop(self):

        tg_log("🔄 Manager loop started")

        consecutive_loop_errors = 0

        

        while not self._stop_flag:

            try:

                with self._lock:

                    mids = list(self.sessions.keys())



                for mid in mids:

                    if self._stop_flag:

                        break

                        

                    s = self.sessions.get(mid)

                    if not s:

                        continue

                    if s.state == BotState.PAUSED.value:

                        continue

                    if s.state != BotState.RUNNING.value:

                        continue



                    # 세션 손실 한도 체크

                    if self._check_session_loss_limit(s):

                        continue  # 한도 초과로 중단됨



                    try:

                        self.sync_trades(mid)

                        self.manage_market(mid)

                    except Exception as market_err:

                        tg_log(f"⚠️ Market {mid} error: {str(market_err)[:80]}")

                        # 개별 마켓 오류는 다음 마켓으로 계속



                self.save_state()

                consecutive_loop_errors = 0  # 성공 시 리셋

                time.sleep(CONFIG["CHECK_INTERVAL"])

                

            except Exception as e:

                consecutive_loop_errors += 1

                tg_log(f"❌ Manager loop error ({consecutive_loop_errors}): {str(e)[:100]}")

                

                # 연속 오류가 많으면 대기 시간 증가

                if consecutive_loop_errors >= 10:

                    tg_log("⚠️ Too many consecutive errors, waiting 60s...")

                    time.sleep(60)

                elif consecutive_loop_errors >= 5:

                    time.sleep(15)

                else:

                    time.sleep(5)



    # ============================================================

    # 🛡️ 손실 보호 로직

    # ============================================================

    def _check_session_loss_limit(self, s: SessionState) -> bool:

        """세션 전체 손실 한도 체크. 한도 초과 시 True 반환."""

        total_budget = Decimal(s.total_budget)

        if total_budget <= 0:

            return False

        

        pnl = s.stats.realized_pnl_d()

        loss_rate = -pnl / total_budget if pnl < 0 else Decimal("0")

        

        if loss_rate >= Decimal(str(CONFIG["MAX_SESSION_LOSS_RATE"])):

            tg_log(f"🚨 SESSION LOSS LIMIT m#{s.market.market_id}: "

                   f"PnL ${pnl:.4f} = {float(loss_rate)*100:.1f}% loss >= {CONFIG['MAX_SESSION_LOSS_RATE']*100:.0f}% limit")

            tg_log(f"🛑 Auto-stopping session m#{s.market.market_id}")

            self.stop_strategy(s.market.market_id)

            return True

        return False



    def _check_sell_protection(self, s: SessionState, side_name: str, 

                                best_ask: Optional[Decimal]) -> bool:

        """

        매도 전 보호 체크. 

        매수가 대비 손실이 MAX_LOSS_TICKS 초과하면 True (매도 거부).

        """

        if best_ask is None:

            return False

        

        # 평균 매수가 가져오기

        if side_name == "YES":

            avg_buy = Decimal(s.yes_avg_buy_price)

            position = Decimal(s.yes_position)

        else:

            avg_buy = Decimal(s.no_avg_buy_price)

            position = Decimal(s.no_position)

        

        # 포지션이 없거나 평균 매수가가 0이면 체크 불필요

        if position <= 0 or avg_buy <= 0:

            return False

        

        # 최소 허용 매도가 계산

        tick = CONFIG["PRICE_QUANT"]

        max_loss_ticks = CONFIG["MAX_LOSS_TICKS"]

        min_sell_price = avg_buy - (tick * max_loss_ticks)

        

        # best_ask가 최소 허용 매도가보다 낮으면 보호 발동

        if best_ask < min_sell_price:

            loss_ticks = int((avg_buy - best_ask) / tick)

            loss_pct = float((avg_buy - best_ask) / avg_buy) * 100

            

            tg_log(f"🛡️ SELL PROTECTION TRIGGERED m#{s.market.market_id} {side_name}")

            tg_log(f"   avg_buy: {avg_buy} | best_ask: {best_ask}")

            tg_log(f"   loss: {loss_ticks} ticks ({loss_pct:.1f}%) > limit {max_loss_ticks} ticks")

            

            s.protection_triggered_count += 1

            

            # 해당 사이드 일시정지

            if CONFIG["PROTECTION_ACTION"] == "pause":

                if side_name == "YES":

                    s.yes_side_paused = True

                else:

                    s.no_side_paused = True

                tg_log(f"⏸️ {side_name} side paused (use /unpause {s.market.market_id} {side_name.lower()} to resume)")

            elif CONFIG["PROTECTION_ACTION"] == "stop":

                tg_log(f"🛑 Stopping session m#{s.market.market_id} due to protection")

                self.stop_strategy(s.market.market_id)

            

            return True

        

        return False



    def _check_price_drop_alert(self, s: SessionState, side_name: str,

                                 best_ask: Optional[Decimal]):

        """급락 감지 알림 (경고만, 동작 차단 안 함)"""

        if best_ask is None:

            return

        

        if side_name == "YES":

            last_ask = Decimal(s.yes_last_best_ask)

            s.yes_last_best_ask = str(best_ask)

        else:

            last_ask = Decimal(s.no_last_best_ask)

            s.no_last_best_ask = str(best_ask)

        

        if last_ask <= 0:

            return

        

        tick = CONFIG["PRICE_QUANT"]

        drop_ticks = int((last_ask - best_ask) / tick)

        

        if drop_ticks >= CONFIG["PRICE_DROP_ALERT_TICKS"]:

            tg_log(f"⚠️ PRICE DROP ALERT m#{s.market.market_id} {side_name}: "

                   f"{last_ask} → {best_ask} ({drop_ticks} ticks drop)")



    def _update_avg_buy_price(self, s: SessionState, side_name: str, 

                               fill_price: Decimal, fill_base: Decimal):

        """매수 체결 시 평균 매수가 업데이트 (가중평균)"""

        if side_name == "YES":

            old_pos = Decimal(s.yes_position)

            old_cost = Decimal(s.yes_total_buy_cost)

        else:

            old_pos = Decimal(s.no_position)

            old_cost = Decimal(s.no_total_buy_cost)

        

        new_cost = old_cost + (fill_price * fill_base)

        new_pos = old_pos + fill_base

        

        if new_pos > 0:

            new_avg = new_cost / new_pos

        else:

            new_avg = Decimal("0")

        

        if side_name == "YES":

            s.yes_total_buy_cost = str(new_cost)

            s.yes_avg_buy_price = str(new_avg)

        else:

            s.no_total_buy_cost = str(new_cost)

            s.no_avg_buy_price = str(new_avg)



    def _update_avg_sell(self, s: SessionState, side_name: str, 

                          sell_base: Decimal):

        """매도 체결 시 평균 매수가 비용 비례 차감"""

        if side_name == "YES":

            old_pos = Decimal(s.yes_position)

            old_cost = Decimal(s.yes_total_buy_cost)

        else:

            old_pos = Decimal(s.no_position)

            old_cost = Decimal(s.no_total_buy_cost)

        

        if old_pos > 0:

            # 비례 차감

            ratio = sell_base / old_pos

            cost_reduction = old_cost * ratio

            new_cost = max(Decimal("0"), old_cost - cost_reduction)

        else:

            new_cost = Decimal("0")

        

        new_pos = max(Decimal("0"), old_pos - sell_base)

        

        if new_pos > 0:

            new_avg = new_cost / new_pos

        else:

            new_avg = Decimal("0")

            new_cost = Decimal("0")

        

        if side_name == "YES":

            s.yes_total_buy_cost = str(new_cost)

            s.yes_avg_buy_price = str(new_avg)

        else:

            s.no_total_buy_cost = str(new_cost)

            s.no_avg_buy_price = str(new_avg)



    # ============================================================

    # session ops

    # ============================================================

    def start_strategy(self, market_id: int, total_budget: Decimal) -> bool:

        if not self.client:

            return False



        # 🎯 get_markets()로 마켓 찾기

        target_market = None

        all_markets = []

        

        try:

            for page in range(1, 21):

                markets = self.client.get_markets(page=page, limit=20)

                if not markets:

                    break

                all_markets.extend(markets)

                if len(markets) < 20:

                    break

            

            # market_id가 parent인지 child인지 확인

            for m in all_markets:

                if m.market_id == market_id and not m.sub_markets:

                    # Binary market (YES/NO)

                    target_market = m

                    break

                elif m.sub_markets:

                    # Child market 확인

                    for sub in m.sub_markets:

                        if sub.outcome_id == market_id:

                            # Child를 독립 MarketInfo로 변환

                            target_market = MarketInfo(

                                market_id=sub.outcome_id,

                                title=f"{m.title} - {sub.name}",

                                yes_token_id=sub.token_id,

                                no_token_id=sub.no_token_id,

                                status=m.status,

                                volume=sub.volume,

                                sub_markets=[],

                            )

                            tg_log(f"✅ Found child market #{market_id} ({sub.name})")

                            break

                if target_market:

                    break

        except Exception as e:

            tg_log(f"❌ Failed to fetch markets: {e}")

            return False

        

        if not target_market:

            tg_log(f"❌ Market {market_id} not found")

            return False

        

        # Binary 마켓 체크 (YES/NO 토큰 필수)

        if not target_market.yes_token_id or not target_market.no_token_id:

            tg_log(f"❌ Market {market_id} has no YES/NO tokens")

            tg_log(f"   Title: {target_market.title}")

            if target_market.sub_markets:

                tg_log(f"   This is a parent topic with {len(target_market.sub_markets)} outcomes")

                tg_log("   Use /market <id> to see child markets")

            return False



        # 예산 배분 계산

        yes_ratio, no_ratio = self._calculate_budget_ratio(target_market)

        yes_budget = total_budget * yes_ratio

        no_budget = total_budget * no_ratio



        with self._lock:

            if market_id in self.sessions and self.sessions[market_id].state == BotState.RUNNING.value:

                tg_log("⚠️ already running")

                return False



            s = SessionState(

                market=target_market,

                total_budget=str(total_budget),

                yes_budget=str(yes_budget),

                no_budget=str(no_budget),

                yes_position="0",

                no_position="0",

                stats=Stats(),

                state=BotState.RUNNING.value,

                seen_trade_uids=[],

            )

            self.sessions[market_id] = s

            self._seen_deques[market_id] = deque(maxlen=CONFIG["TRADE_DEDUPE_MAX"])

            self._seen_sets[market_id] = set()



        tg_log("=" * 44)

        tg_log(f"🚀 Started strategy market #{market_id}")

        tg_log(f"📝 {target_market.title}")

        tg_log(f"💰 Budget: ${total_budget}")

        tg_log(f"   YES: ${yes_budget:.2f} ({float(yes_ratio)*100:.0f}%)")

        tg_log(f"   NO:  ${no_budget:.2f} ({float(no_ratio)*100:.0f}%)")

        tg_log(f"🛡️ Loss protection: {CONFIG['MAX_LOSS_TICKS']} ticks max")

        tg_log("=" * 44)

        self.save_state(force=True)

        return True



    def _calculate_budget_ratio(self, market: MarketInfo) -> Tuple[Decimal, Decimal]:

        """

        예산 배분 비율 계산

        

        동적 모드: 가격 비례 + 유동성 가중

        - 고확률(고가) 쪽에 더 많이 배분 (1틱 변동에 덜 민감)

        - 유동성 좋은 쪽에 약간 더 배분

        - 30~70% 범위 제한

        

        손실 관점:

        - YES 3¢에서 1틱 하락 → 3.3% 손실 (위험 높음)

        - NO 97¢에서 1틱 하락 → 0.1% 손실 (위험 낮음)

        → 고확률(NO) 쪽에 더 많이 배분하면 손실 위험 감소

        """

        if CONFIG["BUDGET_ALLOCATION_MODE"] == "fixed":

            return Decimal("0.5"), Decimal("0.5")

        

        # 현재 가격 조회

        yes_bid, yes_ask = self.client.get_best_prices(market.yes_token_id)

        no_bid, no_ask = self.client.get_best_prices(market.no_token_id)

        

        # 가격 없으면 50:50

        if not yes_bid or not no_bid:

            tg_log("⚠️ Price not available, using 50:50")

            return Decimal("0.5"), Decimal("0.5")

        

        yes_price = yes_bid

        no_price = no_bid

        

        # 유동성 조회 (상위 5개 호가 총합)

        yes_book = self.client.get_orderbook(market.yes_token_id)

        no_book = self.client.get_orderbook(market.no_token_id)

        

        yes_depth = sum(b["size"] * b["price"] for b in yes_book["bids"][:5]) if yes_book["bids"] else Decimal("1")

        no_depth = sum(b["size"] * b["price"] for b in no_book["bids"][:5]) if no_book["bids"] else Decimal("1")

        

        total_depth = yes_depth + no_depth

        if total_depth <= 0:

            total_depth = Decimal("1")

        

        # 가격 기반 위험 가중치 (고확률 = 고가에 더 많이)

        # YES 3¢ → 가중치 0.03 (적게)

        # NO 97¢ → 가중치 0.97 (많이)

        yes_risk_weight = yes_price

        no_risk_weight = no_price

        

        # 유동성 가중치

        yes_depth_weight = yes_depth / total_depth

        no_depth_weight = no_depth / total_depth

        

        # 혼합 (위험 70% + 유동성 30%)

        yes_weight = Decimal("0.7") * yes_risk_weight + Decimal("0.3") * yes_depth_weight

        no_weight = Decimal("0.7") * no_risk_weight + Decimal("0.3") * no_depth_weight

        

        total_weight = yes_weight + no_weight

        if total_weight <= 0:

            return Decimal("0.5"), Decimal("0.5")

        

        yes_ratio = yes_weight / total_weight

        

        # 30~70% 제한

        min_ratio = CONFIG["DYNAMIC_RATIO_MIN"]

        max_ratio = CONFIG["DYNAMIC_RATIO_MAX"]

        yes_ratio = max(min_ratio, min(max_ratio, yes_ratio))

        no_ratio = Decimal("1") - yes_ratio

        

        tg_log(f"📊 Budget allocation: YES {float(yes_price)*100:.1f}¢ / NO {float(no_price)*100:.1f}¢")

        tg_log(f"   Depth: YES ${float(yes_depth):.0f} / NO ${float(no_depth):.0f}")

        tg_log(f"   Ratio: YES {float(yes_ratio)*100:.0f}% / NO {float(no_ratio)*100:.0f}%")

        

        return yes_ratio, no_ratio



    def stop_strategy(self, market_id: Optional[int] = None):

        if market_id is None:

            with self._lock:

                mids = list(self.sessions.keys())

            for mid in mids:

                self.stop_strategy(mid)

            return



        with self._lock:

            s = self.sessions.get(market_id)

            if not s:

                return

            s.state = BotState.STOPPING.value



        tg_log(f"🛑 Stopping market #{market_id} ...")

        self.cancel_session_orders(market_id, refund=True)



        with self._lock:

            s = self.sessions.get(market_id)

            if s:

                s.state = BotState.IDLE.value

        self.save_state(force=True)

        tg_log(f"✅ Stopped market #{market_id}")



    def pause_strategy(self, market_id: int):

        with self._lock:

            s = self.sessions.get(market_id)

            if s and s.state == BotState.RUNNING.value:

                s.state = BotState.PAUSED.value

                self.save_state(force=True)

        tg_log(f"⏸️ Paused market #{market_id}")



    def resume_strategy(self, market_id: int):

        with self._lock:

            s = self.sessions.get(market_id)

            if s and s.state == BotState.PAUSED.value:

                s.state = BotState.RUNNING.value

                self.save_state(force=True)

        tg_log(f"▶️ Resumed market #{market_id}")



    def unpause_side(self, market_id: int, side_name: str):

        """보호로 일시정지된 사이드 해제"""

        with self._lock:

            s = self.sessions.get(market_id)

            if not s:

                tg_log(f"❌ Session not found: {market_id}")

                return

            

            if side_name.upper() == "YES":

                s.yes_side_paused = False

                tg_log(f"▶️ YES side unpaused m#{market_id}")

            elif side_name.upper() == "NO":

                s.no_side_paused = False

                tg_log(f"▶️ NO side unpaused m#{market_id}")

            else:

                tg_log(f"❌ Invalid side: {side_name}")

                return

            

            self.save_state(force=True)



    # trade dedupe

    def _seen_has(self, market_id: int, uid: str) -> bool:

        return uid in self._seen_sets.get(market_id, set())



    def _seen_add(self, market_id: int, uid: str):

        st = self._seen_sets.setdefault(market_id, set())

        dq = self._seen_deques.setdefault(market_id, deque(maxlen=CONFIG["TRADE_DEDUPE_MAX"]))

        if uid in st:

            return

        st.add(uid)

        dq.append(uid)

        s = self.sessions.get(market_id)

        if s:

            s.seen_trade_uids = list(dq)



    def sync_trades(self, market_id: int):

        if not self.client:

            return

        s = self.sessions.get(market_id)

        if not s:

            return



        trades = self.client.get_my_trades(market_id=market_id, limit=200)

        if not trades:

            return



        for tr in trades:

            pt = parse_trade(tr, self.client.maker_fee_rate, self.client.taker_fee_rate)

            if not pt:

                continue

            if self._seen_has(market_id, pt.uid):

                continue

            self._seen_add(market_id, pt.uid)

            self.apply_trade(s, pt)



        self.save_state()



    def find_order_by_id(self, s: SessionState, order_id: Optional[str]) -> Optional[OrderInfo]:

        if not order_id:

            return None

        for o in [s.yes_buy_order, s.no_buy_order, s.yes_sell_order, s.no_sell_order]:

            if o and o.order_id == order_id:

                return o

        return None



    def clear_order_ref(self, s: SessionState, o: OrderInfo):

        if s.yes_buy_order is o: s.yes_buy_order = None

        if s.no_buy_order is o: s.no_buy_order = None

        if s.yes_sell_order is o: s.yes_sell_order = None

        if s.no_sell_order is o: s.no_sell_order = None



    def maybe_mark_filled(self, s: SessionState, o: OrderInfo):

        eps = CONFIG["FILLED_EPS"]

        if o.is_buy:

            if o.total_quote_d() > 0 and (o.filled_quote_d() + eps) >= o.total_quote_d():

                o.status = "filled"

                self.clear_order_ref(s, o)

                tg_log(f"✅ BUY FILLED {o.side} m#{s.market.market_id} @ {o.price}")

        else:

            if o.total_base_d() > 0 and (o.filled_base_d() + eps) >= o.total_base_d():

                o.status = "filled"

                self.clear_order_ref(s, o)

                tg_log(f"✅ SELL FILLED {o.side} m#{s.market.market_id} @ {o.price}")



    def apply_trade(self, s: SessionState, pt: ParsedTrade):

        side_name = None

        if pt.token_id == s.market.yes_token_id:

            side_name = "YES"

        elif pt.token_id == s.market.no_token_id:

            side_name = "NO"



        tracked = self.find_order_by_id(s, pt.order_id) if pt.order_id else None

        is_buy = pt.is_buy if pt.is_buy is not None else (tracked.is_buy if tracked else None)

        if side_name is None and tracked:

            side_name = tracked.side



        if is_buy is None or side_name not in ("YES", "NO"):

            return



        if tracked:

            tracked.add_fill(pt.quote, pt.base)

            self.maybe_mark_filled(s, tracked)



        st = s.stats

        st.total_trades += 1

        st.total_volume = str(st.total_volume_d() + pt.quote)

        st.total_fees = str(st.total_fees_d() + pt.fee_quote)



        if is_buy:

            st.buy_cost = str(st.buy_cost_d() + pt.quote)

            if side_name == "YES":

                s.yes_position = str(Decimal(s.yes_position) + pt.base)

            else:

                s.no_position = str(Decimal(s.no_position) + pt.base)

            

            # 🛡️ 평균 매수가 업데이트

            self._update_avg_buy_price(s, side_name, pt.price, pt.base)

            

            tg_log(f"🎯 FILL BUY {side_name} m#{s.market.market_id}: +{pt.base:.6f} @ {q_price(pt.price)} "

                   f"(${pt.quote:.4f}, fee~${pt.fee_quote:.4f})")

        else:

            st.sell_proceeds = str(st.sell_proceeds_d() + pt.quote)

            if side_name == "YES":

                s.yes_position = str(Decimal(s.yes_position) - pt.base)

                s.yes_budget = str(Decimal(s.yes_budget) + pt.quote)

            else:

                s.no_position = str(Decimal(s.no_position) - pt.base)

                s.no_budget = str(Decimal(s.no_budget) + pt.quote)

            

            # 🛡️ 평균 매수가 비용 차감

            self._update_avg_sell(s, side_name, pt.base)

            

            tg_log(f"🎯 FILL SELL {side_name} m#{s.market.market_id}: -{pt.base:.6f} @ {q_price(pt.price)} "

                   f"(${pt.quote:.4f}, fee~${pt.fee_quote:.4f})")



        st.recompute_pnl()



    def reconcile_orders(self, market_id: int):

        if not self.client:

            return

        s = self.sessions.get(market_id)

        if not s:

            return



        open_orders = self.client.get_my_orders(market_id=market_id, limit=200, status=None)

        open_ids = set()

        for od in open_orders:

            oid = od.get("orderId") or od.get("order_id") or od.get("orderID")

            if oid:

                open_ids.add(str(oid))



        for o in [s.yes_buy_order, s.no_buy_order, s.yes_sell_order, s.no_sell_order]:

            if not o or o.status != "open":

                continue

            if o.order_id in open_ids:

                continue



            info = self.get_order_by_id(o.order_id)  # ✅ Wrapper 사용

            if not info:

                o.status = "cancelled"

                self.clear_order_ref(s, o)

                continue



            status_val = str(info.get("status") or info.get("orderStatus") or "").lower()

            if "fill" in status_val:

                o.status = "filled"

                self.clear_order_ref(s, o)

            elif "cancel" in status_val:

                o.status = "cancelled"

                self.clear_order_ref(s, o)



        self.save_state()



    # order ops

    def cancel_buy_with_refund(self, s: SessionState, side_name: str, o: OrderInfo):

        """

        Buy 주문 취소 + Budget refund

        ⚠️ CRITICAL: API로 실제 체결 양을 확인해서 정확히 refund!

        """

        # 1) API로 실제 주문 상태 조회 (Retry 로직 포함)

        order_data = self.get_order_by_id(o.order_id) if self.client else None

        

        if order_data:

            # API에서 실제 filled 양 가져오기

            api_filled_quote = safe_decimal(order_data.get("filled_quote_amount", 0)) or Decimal("0")

            api_filled_base = safe_decimal(order_data.get("filled_base_amount", 0)) or Decimal("0")

            api_status = order_data.get("status", "")

            

            # OrderInfo 업데이트

            o.filled_quote = str(api_filled_quote)

            o.filled_base = str(api_filled_base)

            

            # 2) 체결 완료 확인

            if api_filled_quote > 0:

                # Position 업데이트

                if side_name == "YES":

                    s.yes_position = str(Decimal(s.yes_position) + api_filled_base)

                else:

                    s.no_position = str(Decimal(s.no_position) + api_filled_base)

                

                # Stats 업데이트

                s.stats.buy_cost = str(s.stats.buy_cost_d() + api_filled_quote)

                

                # 평균 매수가 업데이트

                if api_filled_base > 0:

                    avg_price = api_filled_quote / api_filled_base

                    self._update_avg_buy_price(s, side_name, avg_price, api_filled_base)

                

                tg_log(f"✅ {side_name} BUY filled during cancel: {api_filled_base} shares @ ${api_filled_quote:.2f}")

        

        # 3) 취소 시도

        ok = self.client.cancel_order(o.order_id) if self.client else False

        

        # 4) Refund 계산 (실제 filled 반영)

        remaining = max(Decimal("0"), o.total_quote_d() - o.filled_quote_d())

        

        if remaining > 0:

            if side_name == "YES":

                s.yes_budget = str(Decimal(s.yes_budget) + remaining)

            else:

                s.no_budget = str(Decimal(s.no_budget) + remaining)

            tg_log(f"↩️ REFUND {side_name} BUY m#{s.market.market_id}: ${remaining:.4f}")

        

        # 5) 주문 상태 업데이트

        if o.filled_quote_d() >= o.total_quote_d() * Decimal("0.99"):

            o.status = "filled"

        else:

            o.status = "cancelled"

        

        self.clear_order_ref(s, o)

        

        if ok:

            tg_log(f"🧹 CANCEL BUY {side_name} m#{s.market.market_id} @ {o.price}")



    def cancel_sell(self, s: SessionState, side_name: str, o: OrderInfo):

        ok = self.client.cancel_order(o.order_id) if self.client else False

        o.status = "cancelled"

        self.clear_order_ref(s, o)

        if ok:

            tg_log(f"🧹 CANCEL SELL {side_name} m#{s.market.market_id} @ {o.price}")



    def cancel_session_orders(self, market_id: int, refund: bool = True):

        s = self.sessions.get(market_id)

        if not s or not self.client:

            return



        for side_name, o in [

            ("YES", s.yes_buy_order), ("NO", s.no_buy_order),

            ("YES", s.yes_sell_order), ("NO", s.no_sell_order),

        ]:

            if not o or o.status != "open":

                continue

            if o.is_buy and refund:

                self.cancel_buy_with_refund(s, side_name, o)

            else:

                self.cancel_sell(s, side_name, o)



        tg_log(f"🗑️ Session orders cancelled m#{market_id}")



    def guard_block(self, market_id: int, label: str, msg: str) -> bool:

        if not CONFIG["MAKER_ONLY_GUARD"]:

            return False

        key = f"{market_id}:{label}"

        now = time.time()

        last = self._last_guard_log.get(key, 0.0)

        if now - last >= CONFIG["GUARD_LOG_THROTTLE_SEC"]:

            self._last_guard_log[key] = now

            tg_log(msg)

        return True



    # main per-market decision

    def manage_market(self, market_id: int):

        if not self.client:

            return

        s = self.sessions.get(market_id)

        if not s:

            return



        self._manage_side(s, "YES")

        self._manage_side(s, "NO")

        self.save_state()



    def _manage_side(self, s: SessionState, side_name: str):

        # 🛡️ 사이드별 일시정지 체크

        if side_name == "YES" and s.yes_side_paused:

            return

        if side_name == "NO" and s.no_side_paused:

            return

        

        token_id = s.market.yes_token_id if side_name == "YES" else s.market.no_token_id

        budget = Decimal(s.yes_budget) if side_name == "YES" else Decimal(s.no_budget)

        position = Decimal(s.yes_position) if side_name == "YES" else Decimal(s.no_position)



        best_bid, best_ask = self.client.get_best_prices(token_id)



        # 🛡️ 급락 감지

        self._check_price_drop_alert(s, side_name, best_ask)



        # 1) if buy order open, keep it at best_bid

        buy_order = s.yes_buy_order if side_name == "YES" else s.no_buy_order

        if buy_order and buy_order.status == "open":

            if best_bid is not None:

                target = q_price(best_bid)

                if q_price(buy_order.price_d()) != target:

                    # Pushed 감지! 취소 후 즉시 재주문

                    tg_log(f"📉 {side_name} BUY pushed m#{s.market.market_id}: {buy_order.price} != best_bid {target}")

                    self.cancel_buy_with_refund(s, side_name, buy_order)

                    

                    # 🔄 재주문 전 position 재확인 (체결되었을 수 있음)

                    position = Decimal(s.yes_position) if side_name == "YES" else Decimal(s.no_position)

                    if position >= CONFIG["MIN_ORDER_SIZE"]:

                        # Position이 생겼다 = 체결됨! buy 하지 않고 다음 루프에서 sell 로직으로

                        tg_log(f"✅ {side_name} BUY filled during push check, switching to SELL mode")

                        return

                    

                    # Position 없으면 즉시 재주문

                    if budget >= CONFIG["MIN_ORDER_SIZE"]:

                        my_price = q_price(best_bid)

                        my_price = max(Decimal("0.01"), min(my_price, Decimal("0.99")))

                        

                        # Maker-only guard 체크

                        if CONFIG["MAKER_ONLY_GUARD"] and best_ask is not None and best_ask <= best_bid:

                            self.guard_block(s.market.market_id, f"{side_name}:BUY",

                                           f"🧷 Guard: skip {side_name} BUY m#{s.market.market_id} (재주문)")

                        else:

                            self.place_buy(s, side_name, token_id, budget, my_price, best_bid)

                    return

                else:

                    # 가격이 맞으면 유지

                    return

            else:

                # best_bid가 없으면 유지

                return



        # 2) if position exists, manage sell at best_ask

        sell_order = s.yes_sell_order if side_name == "YES" else s.no_sell_order

        if position >= CONFIG["MIN_ORDER_SIZE"]:

            if sell_order and sell_order.status == "open":

                if best_ask is not None:

                    target = q_price(best_ask)

                    if q_price(sell_order.price_d()) != target:

                        # SELL Pushed 감지! 취소 후 즉시 재주문

                        tg_log(f"📈 {side_name} SELL pushed m#{s.market.market_id}: {sell_order.price} != best_ask {target}")

                        self.cancel_sell(s, side_name, sell_order)

                        

                        # 🔄 즉시 재주문: 밀렸을 때의 best_ask로!

                        # 매도 보호 체크

                        if self._check_sell_protection(s, side_name, best_ask):

                            # 보호 발동, 재주문 안 함

                            return

                        

                        # Maker-only guard 체크

                        if CONFIG["MAKER_ONLY_GUARD"] and best_bid is not None and best_bid >= best_ask:

                            self.guard_block(s.market.market_id, f"{side_name}:SELL",

                                           f"🧷 Guard: skip {side_name} SELL m#{s.market.market_id} (재주문)")

                        else:

                            my_price = q_price(best_ask)

                            self.place_sell(s, side_name, token_id, position, my_price, best_ask)

                        return

                    else:

                        # 가격이 맞으면 유지

                        return

                else:

                    # best_ask가 없으면 유지

                    return



            if best_ask is None:

                return



            # 🛡️ 매도 보호 체크: 손실이 너무 크면 매도 거부

            if self._check_sell_protection(s, side_name, best_ask):

                return  # 보호 발동, 매도 안 함



            # soft post-only guard

            if CONFIG["MAKER_ONLY_GUARD"] and best_bid is not None and best_bid >= best_ask:

                self.guard_block(s.market.market_id, f"{side_name}:SELL",

                                 f"🧷 Guard: skip {side_name} SELL m#{s.market.market_id}")

                return



            my_price = q_price(best_ask)

            self.place_sell(s, side_name, token_id, position, my_price, best_ask)

            return



        # 3) no position => place buy if budget sufficient

        if budget < CONFIG["MIN_ORDER_SIZE"]:

            return

        if best_bid is None:

            return



        if CONFIG["MAKER_ONLY_GUARD"] and best_ask is not None and best_ask <= best_bid:

            self.guard_block(s.market.market_id, f"{side_name}:BUY",

                             f"🧷 Guard: skip {side_name} BUY m#{s.market.market_id}")

            return



        my_price = q_price(best_bid)

        my_price = max(Decimal("0.01"), min(my_price, Decimal("0.99")))

        self.place_buy(s, side_name, token_id, budget, my_price, best_bid)



    def place_buy(self, s: SessionState, side_name: str, token_id: str,

                  budget: Decimal, my_price: Decimal, best_bid: Optional[Decimal]):

        order_id = self.client.place_limit_order(

            market_id=s.market.market_id,

            token_id=token_id,

            is_buy=True,

            price=my_price,

            amount=budget,

            is_quote_token=True,

        )

        if not order_id:

            return

        o = OrderInfo(

            order_id=order_id,

            token_id=token_id,

            side=side_name,

            is_buy=True,

            price=str(my_price),

            total_quote=str(budget),

            total_base=str(budget / my_price if my_price > 0 else Decimal("0")),

            filled_quote="0",

            filled_base="0",

            status="open",

        )

        if side_name == "YES":

            s.yes_buy_order = o

            s.yes_budget = "0"

        else:

            s.no_buy_order = o

            s.no_budget = "0"



        tg_log(f"📥 {side_name} BUY m#{s.market.market_id}: ${budget:.2f} @ {my_price} (best_bid: {best_bid})")



    def place_sell(self, s: SessionState, side_name: str, token_id: str,

                   position: Decimal, my_price: Decimal, best_ask: Optional[Decimal]):

        order_id = self.client.place_limit_order(

            market_id=s.market.market_id,

            token_id=token_id,

            is_buy=False,

            price=my_price,

            amount=position,

            is_quote_token=False,

        )

        if not order_id:

            return

        o = OrderInfo(

            order_id=order_id,

            token_id=token_id,

            side=side_name,

            is_buy=False,

            price=str(my_price),

            total_quote=str(position * my_price),

            total_base=str(position),

            filled_quote="0",

            filled_base="0",

            status="open",

        )

        if side_name == "YES":

            s.yes_sell_order = o

        else:

            s.no_sell_order = o



        tg_log(f"📤 {side_name} SELL m#{s.market.market_id}: {position:.6f} @ {my_price} (best_ask: {best_ask})")



    # kill switch

    def kill_switch(self):

        if not self.client:

            return



        tg_log("🚨 KILL SWITCH: stopping all strategies...")

        with self._lock:

            mids = list(self.sessions.keys())

            for mid in mids:

                self.sessions[mid].state = BotState.STOPPING.value



        for mid in mids:

            try:

                self.cancel_session_orders(mid, refund=True)

            except:

                pass



        tg_log("🚨 KILL SWITCH: cancelling ALL orders across ALL markets...")

        pages = 0

        total_markets = 0

        cancelled_ok = 0



        for page in range(1, CONFIG["KILL_MAX_PAGES"] + 1):

            markets = self.client.get_markets(page=page, limit=CONFIG["KILL_MARKET_PAGE_LIMIT"])

            if not markets:

                break

            pages += 1

            total_markets += len(markets)

            for m in markets:

                if self.client.cancel_all_orders(m.market_id):

                    cancelled_ok += 1

            tg_log(f"… kill sweep page {page}, markets={len(markets)}")



        tg_log(f"✅ KILL DONE: swept {total_markets} markets")



        with self._lock:

            self.sessions.clear()

            self._seen_sets.clear()

            self._seen_deques.clear()



        try:

            if os.path.exists(CONFIG["STATE_FILE"]):

                os.remove(CONFIG["STATE_FILE"])

        except:

            pass



        tg_log("🧹 All sessions cleared")



    # status

    def summary(self) -> Dict[str, Any]:

        with self._lock:

            mids = list(self.sessions.keys())



        total_vol = Decimal("0")

        total_fee = Decimal("0")

        total_pnl = Decimal("0")

        total_trades = 0

        total_protections = 0



        for mid in mids:

            s = self.sessions.get(mid)

            if not s:

                continue

            total_vol += s.stats.total_volume_d()

            total_fee += s.stats.total_fees_d()

            total_pnl += s.stats.realized_pnl_d()

            total_trades += s.stats.total_trades

            total_protections += s.protection_triggered_count



        return {

            "sessions": len(mids),

            "market_ids": mids,

            "volume": float(total_vol),

            "fees": float(total_fee),

            "pnl": float(total_pnl),

            "trades": total_trades,

            "protections": total_protections,

        }



    def session_status(self, market_id: int) -> Optional[Dict[str, Any]]:

        s = self.sessions.get(market_id)

        if not s:

            return None

        return {

            "state": s.state,

            "market_id": s.market.market_id,

            "title": s.market.title,

            "yes_budget": float(Decimal(s.yes_budget)),

            "no_budget": float(Decimal(s.no_budget)),

            "yes_position": float(Decimal(s.yes_position)),

            "no_position": float(Decimal(s.no_position)),

            "yes_avg_buy": float(Decimal(s.yes_avg_buy_price)),

            "no_avg_buy": float(Decimal(s.no_avg_buy_price)),

            "yes_buy": s.yes_buy_order.price if s.yes_buy_order else None,

            "no_buy": s.no_buy_order.price if s.no_buy_order else None,

            "yes_sell": s.yes_sell_order.price if s.yes_sell_order else None,

            "no_sell": s.no_sell_order.price if s.no_sell_order else None,

            "yes_paused": s.yes_side_paused,

            "no_paused": s.no_side_paused,

            "volume": float(s.stats.total_volume_d()),

            "fees": float(s.stats.total_fees_d()),

            "pnl": float(s.stats.realized_pnl_d()),

            "trades": s.stats.total_trades,

            "protections": s.protection_triggered_count,

        }



