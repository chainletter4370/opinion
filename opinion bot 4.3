class TelegramLogger:

    def __init__(self):

        self._bot: Optional[Bot] = None

        self._chat_id: Optional[str] = None

        self._queue: Queue = Queue()

        self._thread: Optional[threading.Thread] = None

        self._running = False



    def setup(self, bot_token: str, chat_id: str):

        if TELEGRAM_AVAILABLE and bot_token and chat_id:

            self._bot = Bot(token=bot_token)

            self._chat_id = chat_id

            self._running = True

            self._thread = threading.Thread(target=self._sender_loop, daemon=True)

            self._thread.start()



    def _sender_loop(self):

        buf: List[str] = []

        last_send = time.time()

        while self._running:

            try:

                try:

                    msg = self._queue.get(timeout=0.5)

                    buf.append(msg)

                except Empty:

                    pass



                if buf and ((time.time() - last_send) >= 1.0 or len(buf) >= 10):

                    text = "\n".join(buf[-20:])

                    if len(text) > 4000:

                        text = text[-4000:]

                    try:

                        self._bot.send_message(chat_id=self._chat_id, text=text, parse_mode=None)

                    except:

                        pass

                    buf.clear()

                    last_send = time.time()

            except:

                pass



    def log(self, message: str):

        ts = time.strftime("%H:%M:%S")

        self._queue.put(f"[{ts}] {message}")



    def stop(self):

        self._running = False



tg_logger = TelegramLogger()



def tg_log(msg: str):

    tg_logger.log(msg)



