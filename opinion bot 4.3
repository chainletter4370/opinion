def safe_decimal(x) -> Optional[Decimal]:

    if x is None:

        return None

    try:

        if isinstance(x, Decimal):

            return x

        if isinstance(x, (int, float)):

            return Decimal(str(x))

        s = str(x).strip()

        if not s:

            return None

        return Decimal(s)

    except:

        return None



def obj_to_dict(obj: Any) -> Any:

    if obj is None:

        return None

    if isinstance(obj, dict):

        return obj

    if isinstance(obj, (list, tuple)):

        return [obj_to_dict(x) for x in obj]

    if hasattr(obj, "model_dump"):

        try:

            return obj.model_dump()

        except:

            pass

    if hasattr(obj, "__dict__"):

        try:

            d = {}

            for k, v in obj.__dict__.items():

                if k.startswith("_"):

                    continue

                d[k] = obj_to_dict(v)

            return d

        except:

            pass

    return obj



def ensure_dir_for_file(path: str):

    parent = os.path.dirname(os.path.abspath(path))

    if parent and not os.path.exists(parent):

        os.makedirs(parent, exist_ok=True)



def _json_default(obj: Any):

    """json.dump() fallback serializer.



    - Decimal -> string (keeps precision)

    - Enum -> value

    - dataclass / pydantic -> dict

    - set -> list

    """

    try:

        if isinstance(obj, Decimal):

            return str(obj)

        if isinstance(obj, Enum):

            return obj.value

        if isinstance(obj, (set, frozenset)):

            return list(obj)

        if hasattr(obj, "__dataclass_fields__"):

            return {k: getattr(obj, k) for k in obj.__dataclass_fields__.keys()}

        if hasattr(obj, "model_dump"):

            return obj.model_dump()

        if hasattr(obj, "__dict__"):

            d = {}

            for k, v in obj.__dict__.items():

                if not str(k).startswith("_"):

                    d[k] = v

            return d

    except Exception:

        pass

    return str(obj)



def atomic_write_json(path: str, data: Dict[str, Any]):

    """

    Windows 호환 atomic write - 강력한 버전

    - Unique 임시 파일명 (PID + timestamp)

    - 재시도 로직 강화

    - 실패 시 직접 쓰기 fallback

    """

    ensure_dir_for_file(path)

    

    # Unique 임시 파일명 (충돌 방지)

    import random

    tmp_suffix = f".tmp.{os.getpid()}.{int(time.time()*1000)}.{random.randint(1000,9999)}"

    tmp = path + tmp_suffix

    

    # 1. 임시 파일 쓰기

    try:

        with open(tmp, "w", encoding="utf-8") as f:

            json.dump(data, f, ensure_ascii=False, indent=2, default=_json_default)

        # 파일 핸들 완전히 닫히도록 대기

        time.sleep(0.05)

    except Exception as e:

        # 임시 파일 쓰기 실패

        try:

            if os.path.exists(tmp):

                os.remove(tmp)

        except:

            pass

        raise e

    

    # 2. Replace 시도 (최대 5번, 더 긴 간격)

    last_error = None

    for attempt in range(5):

        try:

            # 임시 파일이 여전히 존재하는지 확인

            if not os.path.exists(tmp):

                raise FileNotFoundError(f"Temporary file disappeared: {tmp}")

            

            # Windows: 대상 파일 삭제 시도

            if os.name == 'nt' and os.path.exists(path):

                try:

                    os.remove(path)

                    time.sleep(0.02)  # 삭제 완료 대기

                except (PermissionError, OSError) as e:

                    if attempt < 4:

                        time.sleep(0.1 * (attempt + 1))

                        continue

                    # 마지막 시도에서도 실패하면 직접 쓰기로 fallback

                    last_error = e

                    break

            

            # Replace 실행

            os.replace(tmp, path)

            return  # 성공!

            

        except Exception as e:

            last_error = e

            if attempt < 4:

                time.sleep(0.1 * (attempt + 1))

            else:

                break  # 마지막 시도 실패

    

    # 3. Fallback: 직접 쓰기 (atomic 포기)

    try:

        # 임시 파일 정리

        if os.path.exists(tmp):

            try:

                os.remove(tmp)

            except:

                pass

        

        # 직접 쓰기 (덮어쓰기)

        with open(path, "w", encoding="utf-8") as f:

            json.dump(data, f, ensure_ascii=False, indent=2, default=_json_default)

        return  # Fallback 성공

        

    except Exception as fallback_error:

        # 완전 실패

        raise Exception(f"atomic_write failed: {last_error}, fallback failed: {fallback_error}")



