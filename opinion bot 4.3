@dataclass

class ParsedTrade:

    uid: str

    order_id: Optional[str]

    token_id: Optional[str]

    is_buy: Optional[bool]

    price: Decimal

    base: Decimal

    quote: Decimal

    fee_quote: Decimal



def _trade_uid(d: Dict[str, Any]) -> str:

    a = str(d.get("trade_id") or d.get("tradeId") or d.get("id") or "")

    b = str(d.get("txHash") or d.get("transactionHash") or d.get("hash") or "")

    c = str(d.get("logIndex") or d.get("index") or "")

    t = str(d.get("timestamp") or d.get("createdAt") or d.get("time") or "")

    key = "|".join([x for x in [a, b, c, t] if x])

    return key if key else str(hash(json.dumps(d, sort_keys=True)))



def parse_trade(tr: Any, maker_fee: Decimal, taker_fee: Decimal) -> Optional[ParsedTrade]:

    d = obj_to_dict(tr)

    if not isinstance(d, dict):

        return None



    uid = _trade_uid(d)

    order_id = d.get("order_id") or d.get("orderId") or d.get("orderID")

    token_id = d.get("token_id") or d.get("tokenId")



    side_raw = str(d.get("side") or d.get("orderSide") or d.get("direction") or "").lower()

    is_buy = None

    if "buy" in side_raw:

        is_buy = True

    elif "sell" in side_raw:

        is_buy = False



    price = safe_decimal(d.get("price") or d.get("tradePrice") or d.get("fillPrice") or d.get("rate"))

    if price is None or price <= 0:

        return None



    base = safe_decimal(

        d.get("amountInBaseToken") or d.get("baseAmount") or d.get("makerAmountInBaseToken")

        or d.get("filledBase") or d.get("quantity") or d.get("size")

    )

    quote = safe_decimal(

        d.get("amountInQuoteToken") or d.get("quoteAmount") or d.get("makerAmountInQuoteToken")

        or d.get("filledQuote") or d.get("notional")

    )



    if base is None and quote is not None:

        base = quote / price

    if quote is None and base is not None:

        quote = base * price

    if base is None or quote is None:

        return None



    fee = safe_decimal(d.get("fee") or d.get("feeQuote") or d.get("feeAmount") or d.get("fee_amount"))

    if fee is None:

        role = str(d.get("liquidityRole") or d.get("role") or "").lower()

        is_taker = ("taker" in role) or bool(d.get("isTaker") or d.get("taker"))

        if ("maker" in role) or bool(d.get("isMaker") or d.get("maker")):

            is_taker = False

        fee_rate = taker_fee if is_taker else maker_fee

        fee = quote * fee_rate



    fee = max(Decimal("0"), fee)

    base = max(Decimal("0"), base)

    quote = max(Decimal("0"), quote)

    return ParsedTrade(

        uid=uid,

        order_id=str(order_id) if order_id else None,

        token_id=str(token_id) if token_id else None,

        is_buy=is_buy,

        price=price,

        base=base,

        quote=quote,

        fee_quote=fee,

    )



