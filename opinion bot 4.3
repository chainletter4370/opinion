import random



class OpinionClient:

    def __init__(self):

        if not SDK_AVAILABLE or not ENV_OK:

            raise RuntimeError("SDK or ENV not ready")



        self._init_client()

        self._consecutive_errors = 0

        self._last_error_time = 0.0



    def _init_client(self):

        """클라이언트 초기화/재초기화"""

        self.client = Client(

            host=CONFIG["HOST"],

            apikey=CONFIG["API_KEY"],

            chain_id=CONFIG["CHAIN_ID"],

            rpc_url=CONFIG["RPC_URL"],

            private_key=CONFIG["PRIVATE_KEY"],

            multi_sig_addr=CONFIG["MULTI_SIG_ADDR"],

            conditional_tokens_addr=CONFIG["CONDITIONAL_TOKENS_ADDR"],

            multisend_addr=CONFIG["MULTISEND_ADDR"],

            market_cache_ttl=60,

            quote_tokens_cache_ttl=3600,

        )

        try:

            if hasattr(self.client, "enable_trading"):

                self.client.enable_trading()

        except:

            pass



        self.maker_fee_rate = CONFIG["DEFAULT_MAKER_FEE_RATE"]

        self.taker_fee_rate = CONFIG["DEFAULT_TAKER_FEE_RATE"]

        self._best_effort_load_fee_rates()



    def _is_retryable_error(self, e: Exception) -> bool:

        """재시도 가능한 오류인지 판단"""

        error_str = str(e).lower()

        retryable_patterns = [

            "504", "502", "503", "500",

            "gateway", "timeout", "timed out",

            "connection", "reset", "refused",

            "temporarily", "unavailable",

            "network", "ssl", "eof",

        ]

        return any(p in error_str for p in retryable_patterns)



    def _retry_api_call(self, func, *args, **kwargs):

        """

        API 호출을 재시도 로직으로 감싸기

        - 5xx 오류, 타임아웃, 연결 오류 시 자동 재시도

        - 지수 백오프 적용

        """

        max_retries = CONFIG["API_MAX_RETRIES"]

        base_delay = CONFIG["API_RETRY_DELAY_BASE"]

        max_delay = CONFIG["API_RETRY_DELAY_MAX"]

        

        last_exception = None

        

        for attempt in range(max_retries + 1):

            try:

                result = func(*args, **kwargs)

                # 성공 시 연속 오류 카운터 리셋

                self._consecutive_errors = 0

                return result

                

            except Exception as e:

                last_exception = e

                error_str = str(e)

                

                # 재시도 가능한 오류인지 체크

                if not self._is_retryable_error(e):

                    tg_log(f"❌ API error (non-retryable): {error_str[:100]}")

                    raise

                

                # 504 Gateway Timeout은 일시적 문제 - 간결한 로그

                is_504 = "504" in error_str or "gateway" in error_str.lower()

                

                # 마지막 시도였으면 예외 발생

                if attempt >= max_retries:

                    self._consecutive_errors += 1

                    self._last_error_time = time.time()

                    

                    # 504 에러는 warning 레벨 (서버 일시 문제)

                    if is_504:

                        tg_log(f"⚠️ API timeout after {max_retries+1} attempts (Opinion Trade server busy)")

                    else:

                        tg_log(f"❌ API failed after {max_retries+1} attempts: {error_str[:100]}")

                    

                    # 연속 오류가 임계값 초과하면 클라이언트 재초기화

                    if self._consecutive_errors >= CONFIG["CONSECUTIVE_ERROR_LIMIT"]:

                        tg_log(f"🔄 Reinitializing client after {self._consecutive_errors} consecutive errors...")

                        try:

                            self._init_client()

                            self._consecutive_errors = 0

                            tg_log("✅ Client reinitialized")

                        except Exception as reinit_err:

                            tg_log(f"❌ Client reinit failed: {reinit_err}")

                    raise

                

                # 재시도 대기 (지수 백오프 + 지터)

                delay = min(base_delay * (2 ** attempt) + random.uniform(0, 1), max_delay)

                

                # 504 에러는 첫 시도에서만 로그 (스팸 방지)

                if is_504:

                    if attempt == 0:

                        tg_log(f"⏳ API timeout (attempt 1/{max_retries+1}), retrying...")

                else:

                    tg_log(f"⚠️ API error (attempt {attempt+1}/{max_retries+1}): {error_str[:60]}... retrying in {delay:.1f}s")

                

                time.sleep(delay)

        

        # 여기 도달하면 안 되지만 안전장치

        if last_exception:

            raise last_exception



    def _unwrap(self, resp: Any) -> Tuple[int, Any, str]:

        if resp is None:

            return 999, None, "None response"

        if hasattr(resp, "errno"):

            errno = getattr(resp, "errno", 999) or 0

            errmsg = getattr(resp, "errmsg", "") or ""

            result = getattr(resp, "result", None)

            return int(errno), result, str(errmsg)

        if isinstance(resp, dict):

            errno = resp.get("errno", 0) or 0

            errmsg = resp.get("errmsg", "") or ""

            result = resp.get("result", None)

            return int(errno), result, str(errmsg)

        rd = obj_to_dict(resp)

        if isinstance(rd, dict):

            errno = rd.get("errno", 0) or 0

            errmsg = rd.get("errmsg", "") or ""

            result = rd.get("result", None)

            return int(errno), result, str(errmsg)

        return 999, None, "Unrecognized response"



    def _best_effort_load_fee_rates(self):

        for fn in ["get_fee_rates", "get_fee_rate", "fee_rates"]:

            if hasattr(self.client, fn):

                try:

                    resp = getattr(self.client, fn)()

                    errno, result, _ = self._unwrap(resp)

                    if errno != 0:

                        continue

                    rd = obj_to_dict(result)

                    if isinstance(rd, dict):

                        mf = safe_decimal(rd.get("makerFeeRate") or rd.get("maker_fee_rate") or rd.get("maker"))

                        tf = safe_decimal(rd.get("takerFeeRate") or rd.get("taker_fee_rate") or rd.get("taker"))

                        if mf is not None:

                            self.maker_fee_rate = mf

                        if tf is not None:

                            self.taker_fee_rate = tf

                except:

                    pass



    def get_market(self, market_id: int) -> Optional[MarketInfo]:

        """마켓 상세 조회 (binary + multi-outcome 지원)"""

        try:

            resp = self._retry_api_call(

                self.client.get_market, market_id=market_id, use_cache=False

            )

        except Exception as e:

            tg_log(f"❌ get_market failed: {e}")

            return None

        

        errno, result, _ = self._unwrap(resp)

        if errno != 0:

            return None

        data = getattr(result, "data", result)

        d = obj_to_dict(data)

        if not isinstance(d, dict):

            return None

        

        # 하위 마켓 (outcomes) 파싱 - 가능한 모든 필드 체크

        sub_markets: List[SubMarketInfo] = []

        

        # API 응답에서 outcomes를 찾기 위한 모든 가능한 필드명 시도

        outcomes = (

            d.get("child_markets") or       # ⭐ snake_case 우선!

            d.get("childMarkets") or        # camelCase

            d.get("outcomes") or 

            d.get("marketOptions") or 

            d.get("market_options") or

            d.get("options") or 

            d.get("sub_markets") or

            d.get("subMarkets") or

            d.get("children") or

            []

        )

        

        if outcomes and isinstance(outcomes, list):

            for idx, o in enumerate(outcomes):

                od = obj_to_dict(o)

                if not isinstance(od, dict):

                    continue

                

                # outcome 정보 추출 (다양한 필드명 지원)

                outcome_id = int(od.get("outcome_id") or od.get("outcomeId") or od.get("id") or od.get("optionId") or idx)

                name = str(od.get("name") or od.get("outcome_name") or od.get("outcomeName") or od.get("title") or od.get("optionName") or f"Option {idx}")

                

                # 토큰 ID 추출 (YES 토큰)

                token_id = str(

                    od.get("token_id") or 

                    od.get("tokenId") or 

                    od.get("yes_token_id") or 

                    od.get("yesTokenId") or 

                    od.get("outcomeTokenId") or

                    ""

                )

                

                # NO 토큰 ID

                no_token_id = str(

                    od.get("no_token_id") or 

                    od.get("noTokenId") or 

                    ""

                )

                

                # 볼륨과 확률

                vol = Decimal(str(od.get("volume") or od.get("totalVolume") or 0))

                chance = Decimal(str(od.get("chance") or od.get("probability") or od.get("price") or 0))

                

                sub_markets.append(SubMarketInfo(

                    outcome_id=outcome_id,

                    name=name,

                    token_id=token_id,

                    no_token_id=no_token_id,

                    volume=vol,

                    chance=chance,

                ))

        

        # 볼륨 계산: 하위 마켓이 있으면 합산, 없으면 상위 마켓 볼륨 사용

        if sub_markets:

            # 하위 마켓들의 볼륨 합산

            total_volume = sum(sub.volume for sub in sub_markets)

            # 만약 합산 볼륨이 0이면 상위 마켓 볼륨 사용

            if total_volume == 0:

                total_volume = Decimal(str(d.get("volume") or d.get("total_volume") or d.get("totalVolume") or 0))

        else:

            # binary 마켓: 상위 마켓 볼륨 사용

            total_volume = Decimal(str(d.get("volume") or d.get("total_volume") or d.get("totalVolume") or 0))

        

        # YES/NO 토큰 (binary 마켓용)

        yes_tid = str(d.get("yes_token_id") or d.get("yesTokenId") or "")

        no_tid = str(d.get("no_token_id") or d.get("noTokenId") or "")

        

        # multi-outcome 마켓인데 yes_token_id가 없으면, 첫 번째 하위 마켓의 토큰 사용

        if not yes_tid and sub_markets:

            yes_tid = sub_markets[0].token_id

            no_tid = sub_markets[0].no_token_id

        

        # 타이틀 추출

        title = str(

            d.get("market_title") or 

            d.get("marketTitle") or 

            d.get("title") or 

            d.get("topic_title") or

            d.get("topicTitle") or

            ""

        )

        

        return MarketInfo(

            market_id=int(d.get("market_id") or d.get("marketId") or d.get("topicId") or d.get("topic_id") or market_id),

            title=title,

            yes_token_id=yes_tid,

            no_token_id=no_tid,

            status=int(d.get("status") or d.get("topicStatus") or 0),

            volume=total_volume,

            sub_markets=sub_markets,

        )



    def get_markets(self, page: int = 1, limit: int = 20) -> List[MarketInfo]:

        try:

            resp = self._retry_api_call(

                self.client.get_markets, status=TopicStatusFilter.ACTIVATED, page=page, limit=limit

            )

        except Exception as e:

            tg_log(f"❌ get_markets failed: {e}")

            return []

        

        errno, result, _ = self._unwrap(resp)

        if errno != 0:

            return []

        lst = getattr(result, "list", None)

        if lst is None:

            rd = obj_to_dict(result)

            if isinstance(rd, dict):

                lst = rd.get("list") or rd.get("data") or []

        if not lst:

            return []

        out: List[MarketInfo] = []

        for it in lst:

            d = obj_to_dict(it)

            if not isinstance(d, dict):

                continue

            

            # child_markets 파싱

            sub_markets: List[SubMarketInfo] = []

            child_markets = d.get("child_markets") or d.get("childMarkets") or []

            

            if child_markets and isinstance(child_markets, list):

                for idx, child in enumerate(child_markets):

                    cd = obj_to_dict(child) if not isinstance(child, dict) else child

                    if isinstance(cd, dict):

                        sub_markets.append(SubMarketInfo(

                            outcome_id=int(cd.get("market_id") or cd.get("marketId") or idx),

                            name=str(cd.get("market_title") or cd.get("marketTitle") or cd.get("title") or f"Option {idx}"),

                            token_id=str(cd.get("yes_token_id") or cd.get("yesTokenId") or ""),

                            no_token_id=str(cd.get("no_token_id") or cd.get("noTokenId") or ""),

                            volume=Decimal(str(cd.get("volume") or 0)),

                            chance=Decimal(str(cd.get("chance") or cd.get("probability") or 0)),

                        ))

            

            # 볼륨: child markets가 있으면 합산

            if sub_markets:

                volume = sum(sub.volume for sub in sub_markets)

            else:

                volume = Decimal(str(d.get("volume") or d.get("total_volume") or 0))

            

            yes_tid = d.get("yes_token_id") or d.get("yesTokenId") or ""

            no_tid = d.get("no_token_id") or d.get("noTokenId") or ""

            

            out.append(MarketInfo(

                market_id=int(d.get("market_id") or d.get("marketId") or 0),

                title=str(d.get("market_title") or d.get("marketTitle") or ""),

                yes_token_id=str(yes_tid),

                no_token_id=str(no_tid),

                status=int(d.get("status") or 0),

                volume=volume,

                sub_markets=sub_markets,  # ⭐ child_markets 추가!

            ))

        return out



    def get_orderbook(self, token_id: str) -> Dict[str, List[Dict[str, Decimal]]]:

        try:

            resp = self._retry_api_call(

                self.client.get_orderbook, token_id=token_id

            )

        except Exception as e:

            # 오더북 조회 실패는 조용히 처리 (빈 오더북 반환)

            return {"bids": [], "asks": []}

        

        errno, result, _ = self._unwrap(resp)

        if errno != 0:

            return {"bids": [], "asks": []}



        bids: List[Dict[str, Decimal]] = []

        asks: List[Dict[str, Decimal]] = []



        if hasattr(result, "bids") or hasattr(result, "asks"):

            if getattr(result, "bids", None):

                for b in result.bids:

                    bd = obj_to_dict(b) if not isinstance(b, dict) else b

                    p = safe_decimal(bd.get("price") if isinstance(bd, dict) else getattr(b, "price", None))

                    s = safe_decimal(bd.get("size") if isinstance(bd, dict) else getattr(b, "size", None)) or Decimal("0")

                    if p is not None:

                        bids.append({"price": p, "size": s})

            if getattr(result, "asks", None):

                for a in result.asks:

                    ad = obj_to_dict(a) if not isinstance(a, dict) else a

                    p = safe_decimal(ad.get("price") if isinstance(ad, dict) else getattr(a, "price", None))

                    s = safe_decimal(ad.get("size") if isinstance(ad, dict) else getattr(a, "size", None)) or Decimal("0")

                    if p is not None:

                        asks.append({"price": p, "size": s})

        else:

            rd = obj_to_dict(result)

            if isinstance(rd, dict):

                for b in (rd.get("bids") or []):

                    if isinstance(b, dict):

                        p = safe_decimal(b.get("price"))

                        s = safe_decimal(b.get("size")) or Decimal("0")

                        if p is not None:

                            bids.append({"price": p, "size": s})

                for a in (rd.get("asks") or []):

                    if isinstance(a, dict):

                        p = safe_decimal(a.get("price"))

                        s = safe_decimal(a.get("size")) or Decimal("0")

                        if p is not None:

                            asks.append({"price": p, "size": s})



        return {"bids": bids, "asks": asks}



    def get_best_prices(self, token_id: str) -> Tuple[Optional[Decimal], Optional[Decimal]]:

        book = self.get_orderbook(token_id)

        best_bid = max((x["price"] for x in book["bids"]), default=None)

        best_ask = min((x["price"] for x in book["asks"]), default=None)

        return best_bid, best_ask



    def place_limit_order(self, market_id: int, token_id: str, is_buy: bool,

                          price: Decimal, amount: Decimal, is_quote_token: bool) -> Optional[str]:

        price = q_price(price)

        side_enum = OrderSide.BUY if is_buy else OrderSide.SELL

        order = PlaceOrderDataInput(

            marketId=market_id,

            tokenId=token_id,

            side=side_enum,

            orderType=LIMIT_ORDER,

            price=str(price),

        )

        if is_quote_token:

            order.makerAmountInQuoteToken = float(amount)

        else:

            order.makerAmountInBaseToken = float(amount)



        try:

            resp = self._retry_api_call(

                self.client.place_order, order, check_approval=True

            )

        except Exception as e:

            tg_log(f"❌ place_order exception: {str(e)[:100]}")

            return None

        

        errno, result, errmsg = self._unwrap(resp)

        if errno != 0:

            tg_log(f"❌ place_order failed: {errmsg}")

            return None



        rd = obj_to_dict(result)

        order_id = None

        if isinstance(rd, dict):

            od = rd.get("order_data") or rd.get("orderData") or {}

            if isinstance(od, dict):

                order_id = od.get("order_id") or od.get("orderId")

            order_id = order_id or rd.get("order_id") or rd.get("orderId")

        return str(order_id) if order_id else None



