class TelegramController:

    def __init__(self, mgr: StrategyManager):

        self.mgr = mgr

        self.updater = None

        self._markets_cache: List[MarketInfo] = []



    def _auth(self, update) -> bool:

        if str(update.effective_chat.id) != str(CONFIG["TELEGRAM_CHAT_ID"]):

            if update.message:

                update.message.reply_text("⛔")

            return False

        return True



    def cmd_start(self, update, context):

        if not self._auth(update): return

        update.message.reply_text("🤖 Opinion Volume Bot v4.2\n/help\n🛡️ Loss protection enabled")



    def cmd_help(self, update, context):

        if not self._auth(update): return

        update.message.reply_text(f"""📋 Commands



/markets - Market list

/market <id> - Market detail



/run <id> <budget> - Start

/stop [id] - Stop

/pause <id> /resume <id>

/unpause <id> <yes|no> - Unpause protected side



/status [id] - Status

/volume [id] /fee [id] /pnl [id] /stats [id]



/sellall - Sell all positions at best_ask

/kill - 🚨 KILL SWITCH



⚙️ Settings:

  Allocation: {CONFIG['BUDGET_ALLOCATION_MODE']} ({float(CONFIG['DYNAMIC_RATIO_MIN'])*100:.0f}~{float(CONFIG['DYNAMIC_RATIO_MAX'])*100:.0f}%)

  Max loss: {CONFIG['MAX_LOSS_TICKS']} ticks

  Session limit: {CONFIG['MAX_SESSION_LOSS_RATE']*100:.0f}%

""")



    def cmd_markets(self, update, context):

        if not self._auth(update): return

        if not self.mgr.client:

            update.message.reply_text("❌ client not ready")

            return

        

        # 전체 마켓 가져오기 (v2.3 스타일 - 모든 페이지 순회)

        self._markets_cache = []

        page = 1

        while True:

            markets = self.mgr.client.get_markets(page=page, limit=20)

            if not markets:

                break

            self._markets_cache.extend(markets)

            if len(markets) < 20:

                break

            page += 1

        

        if not self._markets_cache:

            update.message.reply_text("❌ No markets")

            return

        text, kb = self._format_page(0)

        update.message.reply_text(text, reply_markup=kb)



    def _format_page(self, page: int):

        per = 10

        total = (len(self._markets_cache) + per - 1) // per

        start = page * per

        end = min((page + 1) * per, len(self._markets_cache))



        text = f"📊 Markets ({page+1}/{total})\n\n"

        for m in self._markets_cache[start:end]:

            title = m.title.replace("\n", " ")

            text += f"[{m.market_id}] {title[:42]}\n"



        btns = []

        if page > 0:

            btns.append(InlineKeyboardButton("⬅️", callback_data=f"p_{page-1}"))

        if page < total - 1:

            btns.append(InlineKeyboardButton("➡️", callback_data=f"p_{page+1}"))

        return text, InlineKeyboardMarkup([btns]) if btns else None



    def callback_page(self, update, context):

        q = update.callback_query

        if not self._auth(update): return

        q.answer()

        page = int(q.data.split("_")[1])

        text, kb = self._format_page(page)

        q.edit_message_text(text, reply_markup=kb)



    def cmd_market(self, update, context):

        if not self._auth(update): return

        if not context.args:

            update.message.reply_text("/market <id>")

            return

        if not self.mgr.client:

            update.message.reply_text("❌ client not ready")

            return

        

        target_id = int(context.args[0])

        

        def to_price(p: Optional[Decimal]) -> str:

            if p is None:

                return "N/A"

            return f"${float(p):.4f}"



        # 🎯 get_markets()로 전체 목록 가져오기 (child_markets 포함)

        try:

            all_markets = []

            for page in range(1, 21):  # 최대 20페이지

                markets = self.mgr.client.get_markets(page=page, limit=20)

                if not markets:

                    break

                all_markets.extend(markets)

                if len(markets) < 20:

                    break

            

            tg_log(f"📋 Retrieved {len(all_markets)} total markets")

            

            # target_id가 parent인지 child인지 확인

            target_market = None

            parent_market = None

            

            # 1. target_id가 parent market_id와 일치하는지 확인

            for m in all_markets:

                if m.market_id == target_id:

                    if m.sub_markets:

                        # Parent 발견!

                        target_market = m

                        tg_log(f"✅ Found parent market #{target_id} with {len(m.sub_markets)} children")

                        break

                    else:

                        # ID는 맞는데 sub_markets가 없음 (child일 수도)

                        target_market = m

            

            # 2. target_id가 child의 outcome_id인지 확인

            if not target_market or not target_market.sub_markets:

                for m in all_markets:

                    if m.sub_markets:

                        for sub in m.sub_markets:

                            if sub.outcome_id == target_id:

                                parent_market = m

                                tg_log(f"✅ Found as child #{target_id} of parent #{m.market_id}")

                                break

                    if parent_market:

                        break

            

            # 결과 표시

            display_market = parent_market if parent_market else target_market

            

            if display_market and display_market.sub_markets:

                # Multi-outcome market 표시

                text = f"""📊 Topic Market #{display_market.market_id}

📝 {display_market.title}

💰 Total Volume: ${float(display_market.volume):,.2f}



🎯 Child Markets ({len(display_market.sub_markets)}개):

"""

                for sub in display_market.sub_markets[:20]:

                    # 하위 마켓 오더북 조회

                    if sub.token_id:

                        try:

                            sb, sa = self.mgr.client.get_best_prices(sub.token_id)

                        except:

                            sb, sa = None, None

                    else:

                        sb, sa = None, None

                    

                    chance_str = f" ({float(sub.chance)*100:.1f}%)" if sub.chance else ""

                    highlight = "👉 " if sub.outcome_id == target_id else ""

                    

                    text += f"\n{highlight}[{sub.outcome_id}] {sub.name}{chance_str}"

                    text += f"\n    Vol: ${float(sub.volume):,.0f}"

                    text += f"\n    Bid: {to_price(sb)} | Ask: {to_price(sa)}\n"

                

                if len(display_market.sub_markets) > 20:

                    text += f"\n... +{len(display_market.sub_markets) - 20}개 더"

                

                update.message.reply_text(text)

                

            elif target_market:

                # Binary market (YES/NO)

                # get_market()으로 토큰 정보 가져오기 (어쩔 수 없음)

                m = self.mgr.client.get_market(target_id)

                if not m:

                    update.message.reply_text(f"❌ Cannot fetch market details for #{target_id}")

                    return

                

                try:

                    yb, ya = self.mgr.client.get_best_prices(m.yes_token_id)

                    nb, na = self.mgr.client.get_best_prices(m.no_token_id)

                except:

                    yb, ya, nb, na = None, None, None, None

                

                text = f"""📊 Market #{target_market.market_id}

📝 {target_market.title}

💰 Total Volume: ${float(target_market.volume):,.2f}



🟢 YES

  Bid: {to_price(yb)} | Ask: {to_price(ya)}



🔴 NO

  Bid: {to_price(nb)} | Ask: {to_price(na)}"""

                

                update.message.reply_text(text)

            else:

                update.message.reply_text(f"❌ Market #{target_id} not found in {len(all_markets)} markets")

                

        except Exception as e:

            tg_log(f"❌ Error in cmd_market: {e}")

            update.message.reply_text(f"❌ Error: {e}")



