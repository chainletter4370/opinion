# 4. Strategy Manager (Smart Adoption)
# ============================================================
class StrategyManager:
    def __init__(self):
        self.client = None
        self.sessions: Dict[int, SessionState] = {}
        self._lock = threading.RLock()
        self._running = False
        
    def initialize(self):
        try:
            self.client = OpinionClient()
            if os.path.exists(CONFIG["STATE_FILE"]):
                try: os.remove(CONFIG["STATE_FILE"])
                except: pass
            return True
        except: return False

    def start_loop(self):
        self._running = True
        threading.Thread(target=self._main_loop, daemon=True).start()

    def _main_loop(self):
        while self._running:
            try:
                with self._lock:
                    mids = list(self.sessions.keys())
                
                # Global Position Update
                all_positions = self.client.get_my_positions(limit=100)
                for p in all_positions:
                    mid = int(p.get("market_id") or p.get("marketId") or 0)
                    if mid in self.sessions:
                        self._update_session_pos(mid, p)

                for mid in mids:
                    s = self.sessions.get(mid)
                    if not s or not s.is_running: continue
                    
                    if time.time() - s.last_unlock_time < CONFIG["UNLOCK_COOLDOWN"]:
                        continue

                    self._execute_market_logic(s)
                
                time.sleep(CONFIG["CHECK_INTERVAL"])
            except Exception as e:
                time.sleep(5)

    def _update_session_pos(self, mid, p):
        s = self.sessions[mid]
        tid = str(p.get("token_id") or p.get("tokenId"))
        amt = safe_decimal(p.get("shares_owned") or p.get("amount") or 0) or Decimal(0)
        if amt > 1_000_000_000: amt /= Decimal(10**18)
        
        outcome = str(p.get("outcome") or "").upper()
        if outcome == "YES": s.yes_position = str(amt)
        elif outcome == "NO": s.no_position = str(amt)
        else:
            if tid == s.market.yes_token_id: s.yes_position = str(amt)
            elif tid == s.market.no_token_id: s.no_position = str(amt)

    def _execute_market_logic(self, s: SessionState):
        # 1. Fetch Orders (Truth Source)
        open_orders = self.client.get_my_open_orders(s.market.market_id)
        
        s.active_yes_order_id = None
        s.active_yes_price = None
        s.active_no_order_id = None
        s.active_no_price = None
        
        for o in open_orders:
            tid = str(o.get("token_id") or o.get("tokenId"))
            oid = str(o.get("order_id") or o.get("orderId"))
            price = str(o.get("price"))
            
            if tid == s.market.yes_token_id:
                s.active_yes_order_id, s.active_yes_price = oid, price
            elif tid == s.market.no_token_id:
                s.active_no_order_id, s.active_no_price = oid, price

        # 2. Manage Sell Sides
        self._manage_side(s, "YES", s.market.yes_token_id, s.yes_position, s.active_yes_order_id, s.active_yes_price)
        self._manage_side(s, "NO", s.market.no_token_id, s.no_position, s.active_no_order_id, s.active_no_price)

    def _manage_side(self, s, side_name, tid, pos_str, active_oid, active_price):
        pos = Decimal(pos_str)
        if pos < CONFIG["MIN_ORDER_SIZE"]: return 

        bb, ba = self.client.get_best_prices(tid)
        if ba is None: return 

        target_price = q_price(ba)
        # Dust check
        if (pos * target_price) < CONFIG["MIN_VALUE_USDT"]: return

        # CASE 1: Order Exists -> CHECK PRICE
        if active_oid:
            current_order_price = q_price(Decimal(active_price))
            if current_order_price == target_price:
                # ✅ Perfect. Do nothing. (Preserves Queue Priority)
                return
            else:
                # Price pushed. Cancel.
                tg_log.log(f"📉 {side_name} Pushed #{s.market.market_id}: {current_order_price} -> {target_price}")
                self.client.cancel_order(active_oid)
            return

        # CASE 2: No Order -> PLACE NEW
        if CONFIG["MAKER_ONLY_GUARD"] and bb and bb >= target_price: return

        oid, err = self.client.place_order(s.market.market_id, tid, False, target_price, pos, False)
        
        if oid:
            tg_log.log(f"📤 {side_name} SELL #{s.market.market_id}: {pos:.2f} @ {target_price}")
        elif err and "Insufficient" in str(err):
            # Fallback: We checked orders but still failed? Real ghost lock.
            tg_log.log(f"🔓 Force Unlocking #{s.market.market_id} (Sync Mismatch)")
            self.client.cancel_all_orders(s.market.market_id)
            s.last_unlock_time = time.time()

    def trigger_sell_all(self):
        tg_log.log("🚨 TRIGGERING SELL ALL...")
        positions = self.client.get_my_positions(limit=100)
        
        if not positions:
            tg_log.log("✅ No positions found.")
            return
        
        count = 0
        with self._lock:
            for p in positions:
                mid = int(p.get("market_id") or p.get("marketId") or 0)
                if mid == 0: continue
                
                val = safe_decimal(p.get("current_value_in_quote_token") or 0) or Decimal(0)
                if val < CONFIG["MIN_VALUE_USDT"]: continue

                # Register Session
                if mid not in self.sessions:
                    m = self.client.get_market(mid)
                    if not m: continue
                    self.sessions[mid] = SessionState(
                        market=m, total_budget="0", yes_budget="0", no_budget="0"
                    )
                
                s = self.sessions[mid]
                # 🚨 UPDATE: DO NOT CANCEL HERE. Just enable management.
                s.is_running = True
                count += 1
                
        tg_log.log(f"✅ Sell All Enabled for {count} markets. Adopting existing orders...")


