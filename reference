    def log(self, message, level="INFO", target="trade"):
        """로그 출력"""
        timestamp = time.strftime("%H:%M:%S")
        log_widget = self.trade_log if target == "trade" else self.claim_log

        log_widget.insert(END, f"[{timestamp}] {message}\n")

        line_start = log_widget.index("end-2c linestart")
        line_end = log_widget.index("end-1c")
        log_widget.tag_add(level, line_start, line_end)

        colors = {"INFO": "black", "SUCCESS": "green", "ERROR": "red", "WARNING": "orange"}
        log_widget.tag_config(level, foreground=colors.get(level, "black"))

        log_widget.see(END)
        self.root.update()

    def clear_trade_log(self):
        self.trade_log.delete(1.0, END)

    def clear_claim_log(self):
